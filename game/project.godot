; Engine configuration file.
; Projeto independente de pesquisa (sonic-megadrive). Sem afiliação com detentores de marcas.

config_version=5

[application]

config/name="Megadrive Platformer Lab"
config/description="Reconstrução independente de pesquisa (sonic-megadrive). Sem afiliação oficial."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Settings="*res://src/saves/settings.gd"
InputRouter="*res://src/input/input_router.gd"
AudioBus="*res://src/audio/audio_bus.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=672
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[physics]

common/physics_ticks_per_second=60
