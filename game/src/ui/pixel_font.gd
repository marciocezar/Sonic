const ACCENTS := {"Á": "A", "À": "A", "Â": "A", "Ã": "A", "É": "E", "Ê": "E", "Í": "I", "Ó": "O",
		"Ô": "O", "Õ": "O", "Ú": "U", "Ç": "C", "Ü": "U"}


static func normalize(t: String) -> String:
	var u := t.to_upper()
	var out := ""
	for ch in u:
		out += ACCENTS.get(ch, ch)
	return out


static func width(t: String, scale: int = 1) -> int:
	return t.length() * 6 * scale


## Desenha texto em um CanvasItem. Sombra opcional em (1,1).
static func draw(ci: CanvasItem, pos: Vector2, t: String, color: Color, scale: int = 1, shadow: bool = true) -> void:
	var s := normalize(t)
	var passes := [true, false] if shadow else [false]
	for is_shadow in passes:
		var x := pos.x
		var off := Vector2(scale, scale) if is_shadow else Vector2.ZERO
		var c := Color(0, 0, 0, 0.75) if is_shadow else color
		for ch in s:
			var g: Array = GLYPHS.get(ch, GLYPHS["?"])
			for row in range(7):
				var line: String = g[row]
				for col in range(5):
					if line[col] == "1":
						ci.draw_rect(Rect2(Vector2(x + col * scale, pos.y + row * scale) + off, Vector2(scale, scale)), c)
			x += 6 * scale
