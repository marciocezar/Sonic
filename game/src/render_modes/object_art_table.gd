static func lookup(zone: int, kind: int, sub: int = -1) -> Array:
	var k := "%d:0x%02X" % [zone, kind]
	if sub >= 0 and OVERRIDES.has(k + ":%d" % sub):
		return OVERRIDES[k + ":%d" % sub]
	if OVERRIDES.has(k):
		return OVERRIDES[k]
	return DEFAULT.get(kind, [])
